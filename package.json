{
  "name": "dexa-attendance-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "pnpm -r typecheck",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:seed": "docker compose exec -T identity-service node dist/seed.js && docker compose exec -T employee-service node dist/seed.js",
    "docker:worker": "pnpm --filter @dexa/event-worker build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
